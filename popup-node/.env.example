# 로컬 `npm run dev` 는 아래를 비워도 된다.
# 저장은 popup-node/data/store.json, 푸시 키는 data/vapid.json 에 자동으로 생긴다.
# 초기화는 그 json 을 지우면 된다. 시드 에이전트 A(11), B(12)가 다시 들어온다.

# --- 배포(Vercel) ---
# Vercel 디스크는 요청 사이에 유지되지 않는다. Postgres가 없으면 API가 503을 낸다.
# 대시보드 Storage에서 Postgres(Neon)를 이 프로젝트에 연결하면 아래 중 하나가 생긴다.
# 코드는 DATABASE_URL, 없으면 POSTGRES_URL, 없으면 POSTGRES_PRISMA_URL 순으로 읽는다.
# 풀러(pooler) 주소를 쓴다. DATABASE_URL_UNPOOLED 는 읽지 않는다.
DATABASE_URL=

# 웹 푸시. 로컬은 자동 생성. 배포는 직접 넣는다.
# 발급: cd popup-node && npx web-push generate-vapid-keys
# VAPID_SUBJECT 는 mailto: 로 시작하는 연락 메일.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 질문-답 매칭. 없으면 로컬 말뭉치(밤/옷/장면/노드/NFC)로 약·중·강을 나눈다.
# 있으면 text-embedding-3-small 코사인. 짧은 한국어 점수는 행사 전에 한 번 봐야 한다.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 비우면 로컬은 테스트 입구가 켜지고, Vercel 배포는 꺼진다.
# 라이브에서 A/B와 15·18을 보려면 true. 로컬에서 끄려면 false.
# ENABLE_TEST_AGENTS=true
